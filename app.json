{
  "name": "MEND UK",
  "slug": "mend-uk",
  "version": "1.0.0",
  "orientation": "portrait",
  "scheme": "mend",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": true,
  "plugins": [
    "expo-router",
    "expo-secure-store",
    "expo-image-picker",
    [
      "@stripe/stripe-react-native",
      {
        "merchantIdentifier": "merchant.uk.mend.app",
        "enableGooglePay": true
      }
    ]
  ],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "uk.mend.app",
    "infoPlist": {
      "CFBundleAllowMixedLocalizations": true,
      "CFBundleLocalizations": [
        "en-GB"
      ]
    }
  },
  "android": {
    "package": "com.mend.uk",
    "permissions": [
      "android.permission.RECORD_AUDIO"
    ]
  },
  "web": {
    "bundler": "metro",
    "output": "single"
  },
  "extra": {
    "environment": "production",
    "router": {}
  },
  "runtimeVersion": "1.0.0",
  "icon": "./assets/mend-uk-icon.png",
  "splash": {
    "image": "./assets/mend-uk-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#FFFFFF"
  },
  "sdkVersion": "57.0.0",
  "platforms": [
    "ios",
    "android",
    "web"
  ]
}
