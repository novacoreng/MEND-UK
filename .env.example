# Expo public values — safe to bundle in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple Pay merchant identifier must match the iOS capability and Stripe configuration.
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.uk.mend.app
# Legacy compatibility: EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only: configure these as Supabase Edge Function secrets.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_URL=https://mend.uk/stripe/connect/return
STRIPE_CONNECT_REFRESH_URL=https://mend.uk/stripe/connect/refresh
AI_API_KEY=
EMAIL_API_KEY=
SMS_API_KEY=

# Supabase Edge Function secrets (DO NOT expose in EXPO_PUBLIC variables)
# Configure in Supabase Dashboard > Edge Functions > Secrets
# AI_API_KEY=
# MEND_AI_MODEL=
# MEND marketplace fee in basis points. Example: 1000 = 10%. Set explicitly in production.
MEND_PLATFORM_FEE_BPS=1000
# Mobile test builds can set true to use Google Pay test environment.
EXPO_PUBLIC_STRIPE_TEST_MODE=true
