    "@supabase/supabase-js": "2.57.0",
    "expo": "~57.0.25",
    "expo-constants": "^18.0.10",
    "expo-font": "~14.0.9",
    "expo-image-picker": "17.0.8",
    "expo-linking": "8.0.8",
    "expo-router": "6.0.15",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
